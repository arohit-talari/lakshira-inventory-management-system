# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.

# Google Sheets document IDs (Add Inventory > File > Share > copy the ID from the URL)
TEST_SHEET_ID=
LIVE_SHEET_ID=

# Anthropic API key, for the Generate Report executive summary
ANTHROPIC_API_KEY=

# Gmail SMTP credentials for emailing generated reports (use a 16-character App Password, not your login password)
EMAIL_SENDER=
EMAIL_PASSWORD=

# Comma-separated list of report recipients
EMAIL_RECIPIENTS=

# MySQL warehouse connection (basket/occasion-aware metrics -- true AOV per
# occasion, Lifetime Loyalty, Purchase Behavior -- are computed here, not
# from the Google Sheet)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Scheduler kill switch for the automated report job (scheduler.py). "test"
# (or any value other than "live") is a complete no-op on every trigger day
# -- no PDF built, no Claude API call, no email sent, just a log line. Set
# to "live" to actually activate automated report generation + email
# delivery. Optional -- defaults to "test" if unset.
SCHEDULER_MODE=test

# Also required, not an environment variable: a Google service account key
# saved as credentials.json in this same directory (also gitignored). See
# ARCHITECTURE.md for how the system authenticates against Google Sheets.
